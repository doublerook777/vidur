# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Required for hosted/local modes. From https://app.gnani.ai/voice (Gnani API Platform).
GNANI_API_KEY=

# Optional LLM fallback parser (any OpenAI-compatible endpoint). Free Groq key: https://console.groq.com/keys
# Enable Zero Data Retention in the Groq console. Leave LLM_API_KEY empty to run on the deterministic parser only.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=

# hosted | local | mock
MODE=local

# hosted mode only
ACCESS_CODE=
PORT=8080
